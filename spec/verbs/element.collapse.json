{
  "name": "element.collapse",
  "strict": true,
  "description": "Collapse an ExpandCollapsePattern element (tree node, combobox, expander). Returns the new state.",
  "input_schema": {
    "type": "object",
    "properties": {
      "handle": {
        "type": "string",
        "description": "Element handle in `elt:N` form."
      }
    },
    "required": [
      "handle"
    ],
    "additionalProperties": false
  },
  "x-crudx": "U",
  "x-since": "2.0",
  "x-namespace": "element",
  "x-output-schema": {
    "type": "object",
    "properties": {
      "new_state": {
        "type": "string",
        "enum": [
          "expanded",
          "collapsed",
          "partially_expanded",
          "leaf"
        ],
        "description": "State after the collapse. `leaf` means the element has no children to expand into. The no-pattern case (element doesn't implement ExpandCollapse at all) is reported as ERR not_supported_by_target."
      }
    },
    "required": [
      "new_state"
    ],
    "additionalProperties": false
  },
  "x-errors": [
    "not_supported_by_target",
    "target_gone",
    "permission_denied",
    "invalid_args"
  ],
  "x-implementations": [
    {
      "name": "uia_collapse",
      "detect": {
        "type": "always"
      },
      "available_on": [
        "windows-modern"
      ],
      "description": "UIA `IUIAutomationExpandCollapsePattern::Collapse` followed by reading `CurrentExpandCollapseState`."
    }
  ],
  "x-families": {
    "windows-modern": {
      "description": "ExpandCollapsePattern.Collapse. Idempotent on already-collapsed elements.",
      "implementations_in_order": [
        "uia_collapse"
      ]
    },
    "windows-classic": {
      "implemented": false,
      "reason": "Requires UI Automation (Vista+)."
    }
  }
}
