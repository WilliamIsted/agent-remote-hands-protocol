{
  "name": "directory.exists",
  "strict": true,
  "description": "Check whether a path exists and is a directory. Returns false for missing paths and for paths that exist but are files. Read-only.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Absolute path to test."
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "x-crudx": "R",
  "x-since": "2.1",
  "x-namespace": "directory",
  "x-output-schema": {
    "type": "object",
    "properties": {
      "exists": {
        "type": "boolean"
      }
    },
    "required": [
      "exists"
    ],
    "additionalProperties": false
  },
  "x-errors": [
    "permission_denied"
  ],
  "x-families": {
    "windows-modern": {
      "description": "GetFileAttributesW + FILE_ATTRIBUTE_DIRECTORY check.",
      "api": "GetFileAttributesW"
    },
    "windows-classic": {
      "description": "GetFileAttributesA on NT 4 / 9x; GetFileAttributesW on NT 5+.",
      "api": [
        "GetFileAttributesA",
        "GetFileAttributesW"
      ]
    }
  }
}
